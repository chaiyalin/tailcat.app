/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; connect-src 'self' https://tailcat.dev wss://*.ipn.dev; font-src 'self'; form-action 'none'; frame-ancestors 'none'; frame-src 'none'; img-src 'self' data: blob:; manifest-src 'self'; media-src 'self' blob:; object-src 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; worker-src 'self' blob:; upgrade-insecure-requests
